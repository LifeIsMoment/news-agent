def clamp(value: int, lower: int, upper: int) -> int:
    return max(lower, min(upper, value))


def parse_datetime(value: Any) -> dt.datetime | None:
    if not value:
        return None
    if isinstance(value, dt.datetime):
        result = value
    else:
        try:
            result = dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        except ValueError:
            try:
                result = dt.datetime.strptime(str(value)[:10], "%Y-%m-%d")
            except ValueError:
                return None
    if result.tzinfo is None:
        result = result.replace(tzinfo=UTC)
    return result.astimezone(UTC)


def load_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return default


def save_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def host_of(url: str) -> str:
    try:
        return urllib.parse.urlsplit(url).netloc.lower().split(":", 1)[0].removeprefix("www.")
    except ValueError:
        return ""


def is_official_host(host: str) -> bool:
    return any(host == domain or host.endswith("." + domain) for domain in OFFICIAL_HOSTS)


def contains_any(text: str, terms: Iterable[str]) -> bool:
    lowered = text.lower()
    return any(term.lower() in lowered for term in terms)


def item_text(item: dict[str, Any]) -> str:
    values = [
        item.get("title", ""), item.get("summary", ""), item.get("source", ""),
        item.get("status", ""), item.get("evidence", ""), item.get("relevance", ""),
        item.get("impact", ""), item.get("confidence", ""), item.get("source_type", ""),
        item.get("track", ""), item.get("priority", ""), item.get("monitor_track", ""),
        item.get("url", ""), " ".join(item.get("query_names", []) or []),
    ]
    return " ".join(str(v) for v in values if v).lower()


def item_is_baseline(item: dict[str, Any]) -> bool:
    return "기준선" in item_text(item) or "baseline" in item_text(item)


def item_is_self_reference(item: dict[str, Any], monitor_repository: str) -> bool:
    text = item_text(item)
    return monitor_repository.lower() in text


def item_is_official(item: dict[str, Any]) -> bool:
    text = item_text(item)
    host = host_of(str(item.get("url", "")))
    source = str(item.get("source", "")).lower()
    status = str(item.get("status", "")).lower()
    evidence = str(item.get("evidence", "")).lower()
    source_type = str(item.get("source_type", "")).lower()
    if is_official_host(host) and "news.google.com" not in host:
        return True
    if any(x in status for x in ("공식", "판결", "법령")):
        return True
    if any(x in evidence for x in ("공식 api", "공식 rest api", "federal register 공식")):
        return True
    if source in {"github releases", "github commits", "pypi json api", "hugging face hub api", "github rest api"}:
        return True
    if source_type in {"official_primary", "repository_primary", "package_primary", "regulator_primary", "standard_setter_primary", "public_api_primary"}:
        return True
    return contains_any(text, ("정부", "위원회", "법원", "commission", "oecd", "wipo")) and is_official_host(host)


def item_is_direct_project_asset(item: dict[str, Any], context: dict[str, Any]) -> bool:
    text = item_text(item)
    target = str(context.get("target_repository", "")).lower()
    return target in text or contains_any(text, PROJECT_SIGNAL_TERMS)


def item_is_generic_github_noise(item: dict[str, Any], context: dict[str, Any]) -> bool:
    if str(item.get("source", "")) != "GitHub Search API":
        return False
    if item_is_direct_project_asset(item, context):
        return False
    text = item_text(item)
    # Generic TaxIA repositories are frequent homonyms and are not enough on their own.
    return not contains_any(text, ("taxia-core", "xaikorea", "xaikorea0", "korean tax", "한국 세법", "graph-rag"))


