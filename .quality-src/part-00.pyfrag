#!/usr/bin/env python3
"""Actionability-first post-processing and bounded self-improvement.

This module converts a broad discovery report into a project application brief.
It also measures report quality and applies only bounded configuration tuning.
Core code and workflow changes are never silently merged by this script; it emits
an explicit maintenance packet for guarded PR automation.
"""
from __future__ import annotations

import argparse
import dataclasses
import datetime as dt
import hashlib
