        if component.get("change") and component["change"] not in changes:
            changes.append(component["change"])

    text = item_text(item)
    binding = contains_any(text, BINDING_TERMS)
    if binding and item_is_official(item) and applicability >= 78:
        decision = "즉시 적용 검토"
    elif applicability >= 72:
        decision = "이번 스프린트 반영"
    else:
        decision = "백로그 등록·검증"

    source_uid = str(item.get("uid") or hashlib.sha256((str(item.get("title")) + str(item.get("url"))).encode()).hexdigest()[:24])
    action_id = "A-" + source_uid[:10]
    limitations = "자동 분류 결과다. 실제 적용범위·시행일·예외·원문 문언은 담당자가 확인해야 한다."
    automatic_scope = (
        "모니터링 필터·점수·보고서 구성은 안전 범위에서 자동 조정 가능. "
        "xaikorea/taxia 소스코드 변경은 해당 저장소 쓰기 권한과 테스트 통과가 있어야 적용 가능."
    )
    return Action(
        action_id=action_id,
        source_uid=source_uid,
        title=str(item.get("title", "")),
        url=str(item.get("url", "")),
        source=str(item.get("source", "")),
        published_at=str(item.get("published_at", "")),
        jurisdiction=str(item.get("jurisdiction", "")),
        category=str(item.get("category", "")),
        importance=str(item.get("importance") or item.get("priority") or ""),
        confidence=confidence,
        actionability=applicability,
        decision=decision,
        component_ids=component_ids,
        components=component_names,
        target_repository=str(context.get("target_repository", "xaikorea/taxia")),
        target_files=paths[:12],
        proposed_change=" ".join(changes),
        implementation_steps=steps[:10],
        acceptance_criteria=acceptance[:10],
        rationale=str(item.get("relevance") or item.get("impact") or primary.get("change") or "프로젝트 구성요소에 직접 매핑됨"),
        evidence=str(item.get("evidence") or "수집 메타데이터"),
        limitations=limitations,
        automatic_scope=automatic_scope,
    )


def build_actions(
    items: list[dict[str, Any]],
    *,
    run_at: dt.datetime,
    context: dict[str, Any],
    tuning: dict[str, Any],
) -> list[Action]:
    actions: list[Action] = []
    seen_sources: set[str] = set()
    for item in items:
        action = make_action(item, run_at=run_at, context=context, tuning=tuning)
        if action is None or action.source_uid in seen_sources:
            continue
        actions.append(action)
        seen_sources.add(action.source_uid)
    actions.sort(key=lambda x: (-x.actionability, -x.confidence, x.title.lower()))
    return actions[: int(tuning.get("max_actions", 12))]


def quality_metrics(
    items: list[dict[str, Any]],
    health: list[dict[str, Any]],
    actions: list[Action],
    *,
    run_at: dt.datetime,
    context: dict[str, Any],
    tuning: dict[str, Any],
) -> dict[str, Any]:
    total = len(items)
    baselines = sum(item_is_baseline(x) for x in items)
    self_refs = sum(item_is_self_reference(x, str(context.get("monitor_repository", ""))) for x in items)
    github_noise = sum(item_is_generic_github_noise(x, context) for x in items)
    misc_items = sum(str(x.get("category", "")) == "기타" for x in items)
    excluded = sum(item_is_excluded(x, context, tuning) for x in items)
    official = sum(item_is_official(x) for x in items)
    stale = 0
    for item in items:
        _, age = recency_score(item, run_at, int(tuning.get("max_age_days", 45)))
        if age is not None and age > int(tuning.get("max_age_days", 45)):
            stale += 1
    failed = sum(not bool(row.get("ok")) for row in health)
    actionable = len(actions)
    action_official = sum(1 for action in actions if is_official_host(host_of(action.url)) or "공식" in action.evidence)
    coverage = len({component for action in actions for component in action.component_ids})
    component_total = max(1, len(context.get("components", {})))
    def ratio(value: int, denominator: int = total) -> float:
        return round(value / denominator, 4) if denominator else 0.0
    noise_count = sum(
        item_is_baseline(item)
        or item_is_self_reference(item, str(context.get("monitor_repository", "")))
        or item_is_generic_github_noise(item, context)
        for item in items
    )
    quality_score = 100
    quality_score -= round(ratio(noise_count) * 45)
    quality_score -= round(ratio(stale) * 20)
    quality_score -= round((failed / max(1, len(health))) * 20)
    if total and actionable == 0:
        quality_score -= 15
    quality_score += min(10, round((coverage / component_total) * 10))
    quality_score = clamp(quality_score, 0, 100)
    return {
        "generated_at": run_at.replace(microsecond=0).isoformat().replace("+00:00", "Z"),
        "total_items": total,
        "actionable_items": actionable,
        "official_items": official,
        "official_action_items": action_official,
        "baseline_items": baselines,
        "self_reference_items": self_refs,
        "generic_github_noise_items": github_noise,
        "misc_items": misc_items,
        "excluded_items": excluded,
        "stale_items": stale,
        "sources_total": len(health),
        "sources_failed": failed,
        "component_coverage": coverage,
        "component_total": component_total,
        "actionable_ratio": ratio(actionable),
        "official_ratio": ratio(official),
        "noise_ratio": ratio(noise_count),
        "stale_ratio": ratio(stale),
        "source_failure_ratio": round(failed / max(1, len(health)), 4),
        "quality_score": quality_score,
    }


def bounded_autotune(tuning: dict[str, Any], metrics: dict[str, Any], report_date: str) -> tuple[dict[str, Any], list[str]]:
    result = json.loads(json.dumps(tuning))
    bounds = result.get("bounds", {})
    changes: list[str] = []

    def adjust(key: str, delta: int) -> None:
        current = int(result.get(key, 0))
        lower, upper = bounds.get(key, [current, current])
        new_value = clamp(current + delta, int(lower), int(upper))
        if new_value != current:
            result[key] = new_value
            changes.append(f"{key}: {current} → {new_value}")

    noise = float(metrics.get("noise_ratio", 0))
    actionable = int(metrics.get("actionable_items", 0))
    total = int(metrics.get("total_items", 0))
